{
  "name": "factory-full-stack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": { "node": "22.16.0", "pnpm": "10.13.1" },
  "scripts": {
    "dev:api": "node --watch --env-file-if-exists=.env --experimental-strip-types server/server.ts",
    "dev:web": "vite",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --experimental-strip-types --env-file-if-exists=.env --test test/http.test.ts",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node --env-file-if-exists=.env dist/server/server.js",
    "db:migrate": "node --experimental-strip-types --env-file-if-exists=.env server/migrate.ts",
    "licenses": "pnpm licenses list --prod"
  },
  "dependencies": {
    "express": "5.2.1",
    "helmet": "8.1.0",
    "pg": "8.22.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "22.19.7",
    "@types/pg": "8.15.6",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": []
  }
}
